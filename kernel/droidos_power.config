# DroidOS kernel fragment: thermal management and a production power profile.
#
# Merged on top of the device defconfig, which is why this is a fragment rather than a full
# defconfig: the SoC vendor already defines clocks and regulators, and duplicating thousands of
# lines here would be a copy that silently rots.
#
#   make -C kernel/droidos/linux ARCH=arm64 droidos_defconfig
#   kernel/droidos/linux/scripts/kconfig/merge_config.sh -m .config device/droidos/../droidos_power.config
#   make -C kernel/droidos/linux ARCH=arm64 olddefconfig
#
# (kernel/Makefile runs exactly that sequence.)

# Frequency scaling with a governor that reacts to utilisation instead of jumping to max.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# Thermal framework: throttle before the SoC protects itself by shutting down.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y

# Multi-core scheduling hints, so the governor sees the whole cluster.
CONFIG_SCHED_MC=y

# Production profile: telemetry and debug instrumentation cost both power and RAM.
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_PAGEALLOC is not set
